{
  "name": "bangdb-manager",
  "private": true,
  "version": "0.4.0",
  "description": "Cross-platform (web/PWA/Android/iOS/desktop) manager for BangDB databases and tables",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/bump-version.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "proxy": "node proxy/server.mjs",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap add android && npx cap sync android",
    "cap:ios": "npx cap add ios && npx cap sync ios",
    "electron": "electron .",
    "desktop": "electron-builder --publish never",
    "desktop:linux": "electron-builder --linux --publish never",
    "desktop:win": "electron-builder --win --publish never",
    "desktop:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.1.2",
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.3"
  },
  "main": "electron/main.mjs",
  "author": {
    "name": "knoxxr",
    "email": "knoxxr@users.noreply.github.com"
  },
  "homepage": "https://github.com/knoxxr/BangDB.Manager",
  "build": {
    "appId": "kr.smic.bangdbmanager",
    "productName": "BangDB Manager",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "proxy/**/*",
      "!proxy/gateway/*.test.mjs",
      "!proxy/package-lock.json",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "bangdb-manager-${version}-windows-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "BangDB Manager"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "artifactName": "bangdb-manager-${version}-linux-${arch}.${ext}",
      "synopsis": "BangDB database manager",
      "desktop": {
        "Name": "BangDB Manager"
      }
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "bangdb-manager-${version}-macos-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "knoxxr",
        "repo": "BangDB.Manager",
        "releaseType": "release"
      }
    ]
  }
}
